# Minimal deterministic stack for Arkade City browser E2E tests.
REGTEST_PROFILES=ark

# Built by ./scripts/regtest.sh build-images from this exact arkd revision.
ARKD_IMAGE=arkd-local:8b34e35
ARKD_WALLET_IMAGE=arkd-wallet-local:8b34e35

ARKD_PASSWORD=secret
ARKD_VTXO_TREE_EXPIRY=8192
ARKD_UNILATERAL_EXIT_DELAY=512
ARKD_PUBLIC_UNILATERAL_EXIT_DELAY=512
ARKD_BOARDING_EXIT_DELAY=1024
ARKD_CHECKPOINT_EXIT_DELAY=512
AUTOMINE_INTERVAL=2

# Avoid host ports commonly occupied by a developer's standalone bitcoind.
# Containers continue to use bitcoin:28332 and bitcoin:28333 internally.
BITCOIN_ZMQ_BLOCK_PORT=38332
BITCOIN_ZMQ_TX_PORT=38333

# Keep protocol test accounting exact.
ARK_OFFCHAIN_INPUT_FEE="0.0"
ARK_ONCHAIN_INPUT_FEE="0.0"
ARK_OFFCHAIN_OUTPUT_FEE="0.0"
ARK_ONCHAIN_OUTPUT_FEE="0.0"

# Arkade City does not need the optional script emulator.
EMULATOR_IMAGE=
